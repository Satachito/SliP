#include <winuser.h>

1 ICON "slip.ico"
1 24   "slip.manifest"

1 VERSIONINFO
FILEVERSION     2,1,1,0
PRODUCTVERSION  2,1,1,0
FILEOS          0x4L
FILETYPE        0x1L
{
	BLOCK "StringFileInfo" {
		BLOCK "040904B0" {
			VALUE "CompanyName",      "Satoru Ogura"
			VALUE "FileDescription",  "SliP, the awesome calculator"
			VALUE "FileVersion",      "2.1.1"
			VALUE "InternalName",     "SliP"
			VALUE "OriginalFilename", "SliP.exe"
			VALUE "ProductName",      "SliP"
			VALUE "ProductVersion",   "2.1.1"
		}
	}
	BLOCK "VarFileInfo" { VALUE "Translation", 0x409, 1200 }
}
