//	A tour of SliP in programming mode. Press CALCULATE.

//	Sentences are parenthesised, and adjacent numbers multiply.
( 'r = 2 )
( 2 π r )

//	Quote defers; : applies, and @ is the argument.
( 'area = '( π × @ × @ ) )
( 3 : area )

//	Comparisons bind tighter than && and ||, which short-circuit.
( 3 > 1 && 5 > 4 )
( [] && ( ¡ `never evaluated` ) )

//	{ } gets its own context, so the binding does not escape …
( { ( 'z = 7 ) ( z ) } )
//	… while « » shares the caller's, so this one does.
( « ( 'w = 9 ) ( w ) » )
( w )

//	Lists, and cons chaining to the right.
( 1 , 2 , [ 3 ] )
( [ 10 20 30 ] : # )

//	∥ evaluates its branches concurrently, isolated, in source order.
( ∥ '[ ( 2 π ) ( cos π ) ( 6 : '( @ × @ ) ) ] )

//	Matrices are values: ± reshapes a copy.
( 'm = ⟨ 1 2 3 4 ⟩ )
( m ± 2 )
( m )
